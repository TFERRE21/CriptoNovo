PORT=3000
# Poll frequency for market discovery (minimum 15s)
POLL_INTERVAL_MS=30000
# Paper wallet balance in USD
PAPER_BALANCE_USD=100
# Virtual order notional in USD
PAPER_ORDER_USD=10
# Minimum pool liquidity in USD
MIN_LIQUIDITY_USD=5000
# Only consider pairs newer than this (hours)
MAX_PAIR_AGE_HOURS=24
# Estimated combined buy+sell cost in percent, for paper PnL only
ESTIMATED_ROUNDTRIP_COST_PCT=1.5
# Net take-profit target in percent
TAKE_PROFIT_NET_PCT=5
# Maximum time in a virtual position
MAX_HOLD_MINUTES=60
# Max simultaneously open paper positions
MAX_OPEN_POSITIONS=3
